{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PRESET_NAME": "${presetName}"
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "toolchainFile": "${sourceDir}/hal/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "toolchainFile": "${sourceDir}/hal/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Tests",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Tests",
        "ENABLE_TESTS": "TRUE"
      }
    },
    {
      "name": "Simulator",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SIMULATOR": "TRUE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Tests",
      "configurePreset": "Tests"
    },
    {
      "name": "Simulator",
      "configurePreset": "Simulator"
    }
  ]
}
